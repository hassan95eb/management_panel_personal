{
  "openapi": "3.0.3",
  "info": {
    "title": "Command Center Codex API",
    "version": "1.0.0"
  },
  "security": [
    {
      "CodexBearer": []
    }
  ],
  "paths": {
    "/api/codex/projects": {
      "get": {
        "summary": "List readable projects and their open tasks",
        "responses": {
          "200": {
            "description": "Readable projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          }
        }
      }
    },
    "/api/codex/projects/{projectId}": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Read a project and its open tasks",
        "responses": {
          "200": {
            "description": "Readable project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          }
        }
      }
    },
    "/api/codex/projects/{projectId}/activities": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "summary": "Record an activity using an idempotency UUID",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivityInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Previously stored activity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Activity"
                }
              }
            }
          },
          "201": {
            "description": "New activity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Activity"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "413": {
            "$ref": "#/components/responses/Error413"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CodexBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "status",
          "repositoryUrl",
          "environmentUrl",
          "nextStep",
          "openTasks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "repositoryUrl": {
            "type": "string",
            "nullable": true
          },
          "environmentUrl": {
            "type": "string",
            "nullable": true
          },
          "nextStep": {
            "type": "string",
            "nullable": true
          },
          "openTasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "dueDate",
          "blockedReason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in-progress",
              "blocked"
            ]
          },
          "priority": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "blockedReason": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ActivityInput": {
        "type": "object",
        "required": [
          "report"
        ],
        "properties": {
          "report": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "link": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "nullable": true
          },
          "taskId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "Activity": {
        "type": "object",
        "required": [
          "id",
          "projectId",
          "taskId",
          "report",
          "link",
          "actorId",
          "source",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "taskId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "report": {
            "type": "string"
          },
          "link": {
            "type": "string",
            "nullable": true
          },
          "actorId": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "codex"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "Error400": {
        "description": "Invalid request",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Error401": {
        "description": "Invalid, missing or revoked key",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Error404": {
        "description": "Resource unavailable",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Error409": {
        "description": "Conflicting operation ID",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Error413": {
        "description": "Body exceeds 64 KiB",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Error415": {
        "description": "Unsupported media type",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Error429": {
        "description": "Request limit reached",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Seconds until a retry can be attempted."
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
